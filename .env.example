# 可选：把三个公开字段统一写为 JSON。不要填写 client secret、refresh token 或用户 access token。
FMG_CLOUD_PROVIDER_CONFIG=

# 可选：不使用统一 JSON 时，逐项配置公开的 OAuth client identifier。
FMG_DROPBOX_APP_KEY=
FMG_DROPBOX_REDIRECT_URI=
FMG_GOOGLE_CLIENT_ID=

# 旧部署兼容；新部署优先使用上面的 Cloud Provider Config。
VITE_FMG_DROPBOX_APP_KEY=
VITE_FMG_DROPBOX_REDIRECT_URI=
VITE_FMG_GOOGLE_CLIENT_ID=
