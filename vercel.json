{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:app",
  "outputDirectory": "dist/webgl-generator",
  "redirects": [
    {
      "source": "/prototype/:prototype",
      "destination": "/prototype/:prototype/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/oauth/dropbox/callback",
      "destination": "/oauth/dropbox/callback/index.html"
    },
    {
      "source": "/prototype/web-cells/",
      "destination": "/prototype/webgl-cells/index.html"
    },
    {
      "source": "/prototype/web-cells/:asset*",
      "destination": "/prototype/webgl-cells/:asset*"
    },
    {
      "source": "/prototype/:prototype/",
      "destination": "/prototype/:prototype/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/cloud-provider-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
