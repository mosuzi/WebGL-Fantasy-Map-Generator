{
  "name": "fmg-webgl-reimplementation",
  "description": "由 mosuzi 创作并完全通过 Codex + GPT 生成的 WebGL 幻想地图生成器。",
  "private": true,
  "author": "mosuzi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mosuzi/fmg-gl.git"
  },
  "generatedBy": "Codex + GPT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run start:app",
    "start": "pnpm run start:app",
    "start:app": "vite --config vite.config.mjs",
    "build": "pnpm run build:app",
    "build:app": "vite build --config vite.config.mjs",
    "preview": "pnpm run preview:app",
    "preview:app": "vite preview --config vite.config.mjs",
    "profile:e2e": "node ./tools/webgl-generator-e2e-profile.mjs",
    "profile:overlay": "node ./tools/webgl-generator-overlay-profile.mjs",
    "profile:panels": "node ./tools/webgl-generator-panel-open-profile.mjs",
    "audit:panels": "node ./tools/webgl-generator-panel-layout-audit.mjs",
    "profile:generation": "node ./tools/webgl-generator-generation-profile.mjs",
    "regress:geo": "node ./tools/webgl-generator-geo-import-regression.mjs",
    "regress:measurement": "node ./tools/webgl-generator-measurement-import-regression.mjs",
    "regress:api": "node ./tools/webgl-generator-api-capabilities-regression.mjs",
    "regress:api-roundtrip": "node ./tools/webgl-generator-api-roundtrip-regression.mjs",
    "regress:api-geo": "node ./tools/webgl-generator-api-geo-regression.mjs",
    "regress:shoreline": "node ./tools/webgl-generator-shoreline-regression.mjs",
    "regress:rendering": "pnpm run regress:shoreline -- --max-switch-ms 1500",
    "diagnose:source-warns": "node ./tools/source-candidate-warn-diagnostics.mjs",
    "start:prototype": "node ./tools/serve-prototype.mjs --port 5400"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.3.0",
    "element-plus": "^2.14.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.0"
  }
}
